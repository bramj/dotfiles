[user]
	name = Bram Jans
	email = ik@bramjans.com
[push]
	default = simple
[alias]

	# From http://blog.apiaxle.com/post/handy-git-tips-to-stop-you-getting-fired/
	assume   = update-index --assume-unchanged
	unassume = update-index --no-assume-unchanged
	assumed  = "!git ls-files -v | grep ^h | cut -c 3-"

	ours   = "!f() { git checkout --ours $@ && git add $@; }; f"
	theirs = "!f() { git checkout --theirs $@ && git add $@; }; f"

	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	lag = log -p
	clg = log --pretty=format:'- %s' --first-parent
	unstage = reset HEAD
	ff = flow feature finish
	fs = flow feature start
	s = status
	d = diff
	a = add
	co = checkout
	b = branch
	l = log
	f = fetch
	r = reset
        ph = push origin HEAD
        phlease = push origin HEAD --force-with-lease
	c = commit
        commend = commit --amend --no-edit
[core]
	excludesfile = ~/.gitignore_global
	editor = /usr/bin/vim
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[init]
	defaultBranch = main
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "http://localhost:3200"]
	provider = generic
[credential "https://git.openhexa.org"]
	provider = generic
