{
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"],
        },
    ],
    "vim.hlsearch": true,
    "vim.handleKeys": {
        "<C-n>": false,
        "<C-p>": false,
        "<C-w>": false,
    },
    "editor.rulers": [80, 120],
    "editor.minimap.enabled": false,
    "editor.wordWrap": "on",
    // "files.trimTrailingWhitespace": true,
    "window.title": "${activeEditorMedium}${separator}${rootName}",
    "explorer.confirmDelete": false,
    "editor.renderWhitespace": "trailing",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "explorer.confirmDragAndDrop": false,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "[generated.graphql]": {
        "editor.formatOnSave": false,
    },
    "black-formatter.args": ["--config", "${workspaceFolder}/pyproject.toml"],
    "black-formatter.path": ["${workspaceFolder}/.venv/bin/black"],
    "terminal.integrated.minimumContrastRatio": 7,
    "eslint.format.enable": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.tabWidth": 4,
    "prettier.singleQuote": true,
    "prettier.arrowParens": "avoid",
    "files.exclude": {
        "**/trypelim": false,
    },
    "explorer.excludeGitIgnore": false,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "prettier.printWidth": 120,
    "window.zoomLevel": -1,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": false,
    },
    "files.associations": {
        "*.yml": "yaml",
        "*.tsx": "typescriptreact",
    },
    "java.imports.gradle.wrapper.checksums": [
        {
            "sha256": "2cae31aaabe2b362438e10dce5538f9a554e183056485df883f45aee08a008e0",
            "allowed": true,
        },
    ],
    "editor.indentSize": "tabSize",
    "workbench.colorTheme": "Light+",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "json.schemas": [],
    // "python.locator": "js",
    "git.openRepositoryInParentFolders": "never",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.next/**": true,
        "**/.venv/**": true,
        "**/node_modules/*/**": true,
        "**/venv/**": true,
    },
    "[typescriptreact]": {},
    "ruff.configuration": "",
    "ruff.format.backend": "uv",
    "workbench.externalBrowser": "firefox",
    "terraform.validation.enableEnhancedValidation": false,
    "chat.disableAIFeatures": true,
}
